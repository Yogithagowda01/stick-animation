# Copy this file to server/.env and fill in your own values.
# NEVER commit the real .env file or share your API key.

# Required: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults shown). Change these if Google renames
# or retires a model again — no code changes needed.
GEMINI_VISION_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Server port
PORT=5000

# Must match the URL the React dev server runs on (Vite default: 5173)
CLIENT_ORIGIN=http://localhost:5173
